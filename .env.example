# ElevenLabs (voiceover + char-level karaoke timing) - required for audio
ELEVENLABS_API_KEY=

# Anthropic (optional AI helpers) - not required to run
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Default narrator voice id (Rachel - realistic, clear female)
BRIEFLY_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional bearer token required by POST /api/books from non-localhost callers.
# Leave empty to allow local/LAN pushes without a token.
BRIEFLY_TOKEN=

# Optional: canonical site URL for OpenGraph/metadata
NEXT_PUBLIC_SITE_URL=https://briefly-bheng.vercel.app

STICKIES_API_BASE=http://localhost:4444
STICKIES_TOKEN=
